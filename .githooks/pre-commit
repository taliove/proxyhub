#!/bin/sh
# Mechanical pre-commit gates (hard floor). The full process - content
# judgment and Check agent semantic review - lives in .claude/skills/pre-commit.
set -e

# 1. Secret scan on staged changes only (fast). Allowlist: .gitleaks.toml.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks)" >&2
  exit 1
fi
gitleaks protect --staged --redact=100 .

# 2. Junk-file guard: paths that must never enter the repo (AGENTS.md §1/§3).
staged=$(git diff --cached --name-only --diff-filter=ACM)
bad=$(printf '%s\n' "$staged" | grep -E '^docs/spec-.*\.md$|_backup\.[^/]*$|_old\.[^/]*$|\.(db|log)$|^config\.yaml$' || true)
if [ -n "$bad" ]; then
  echo "pre-commit: refused staged paths (AGENTS.md §1/§3):" >&2
  printf '%s\n' "$bad" >&2
  exit 1
fi
