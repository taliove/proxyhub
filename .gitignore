# Local runtime state (database, logs, generated xray config, pid)
var/

# AI tooling session state
.superpowers/

# Runtime-generated Xray config (contains per-session VLESS credentials;
# regenerated by the server on every startup)
xray_config.json

# Compiled test binaries (e.g. store.test from `go test -c`)
*.test

