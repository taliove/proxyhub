#!/usr/bin/env bash
# proxyhubctl - ProxyHub operator lifecycle CLI.
#
# Root-only maintenance tool for status, logs, restart, update, backup,
# restore. Acquires an exclusive flock to prevent concurrent operations.
#
# Usage:
#   proxyhubctl status
#   proxyhubctl logs [--follow] [--lines N]
#   proxyhubctl restart
#   proxyhubctl show-info
#   proxyhubctl update [VERSION] [--yes] [--prerelease] [--stable-only]
#                      [--download-base URL]
#   proxyhubctl backup [--protect]
#   proxyhubctl restore ARCHIVE [--yes]
#   proxyhubctl reset-mfa --username NAME [--yes]
#
set -Eeuo pipefail

# Source the helper library. Search order mirrors install.sh: the test
# scratch root first, then the production location next to this script
# (installed as proxyhubctl-lib.sh), then the repo checkout layout.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_ph_lib=""
for _ph_lib_candidate in \
    ${PROXYHUB_ROOT:+"${PROXYHUB_ROOT}/scripts/install/lib.sh"} \
    "${SCRIPT_DIR}/proxyhubctl-lib.sh" \
    "${SCRIPT_DIR}/lib.sh"; do
    [[ ! -r "$_ph_lib_candidate" ]] || { _ph_lib="$_ph_lib_candidate"; break; }
done
[[ -n "$_ph_lib" ]] || {
    printf '[proxyhub] ERROR: cannot locate lib.sh (expected %s)\n' \
        "${SCRIPT_DIR}/proxyhubctl-lib.sh" >&2
    exit 1
}
# Dynamic source path: shellcheck cannot follow it; lib.sh has its own tests.
# shellcheck source=lib.sh
# shellcheck disable=SC1090,SC1091
source "$_ph_lib"
unset _ph_lib _ph_lib_candidate

readonly PROXYHUB_INSTALL_INFO="/root/.proxyhub-install-info"
readonly PROXYHUB_LOCK_FILE="/var/lock/proxyhubctl.lock"
readonly PROXYHUB_LAST_BACKUP_FILE="/var/lib/proxyhub/.last-backup"

# --------------------------------------------------------------------------
# Lock helpers
# --------------------------------------------------------------------------

# acquire_lock - acquire exclusive flock on PROXYHUB_LOCK_FILE.
acquire_lock() {
    if _is_test_mode; then
        _ph_log "test mode: skipping flock"
        return 0
    fi
    local lock_path
    lock_path=$(root_path "$PROXYHUB_LOCK_FILE")
    local lock_dir
    lock_dir=$(dirname "$lock_path")
    mkdir -p "$lock_dir" || {
        _ph_err "failed to create lock directory ${lock_dir}"
        return 1
    }
    exec 200>"$lock_path"
    if ! flock -n 200; then
        _ph_err "another proxyhubctl operation is in progress"
        return 1
    fi
    return 0
}

# --------------------------------------------------------------------------
# Service control
# --------------------------------------------------------------------------

# service_stop - stop the proxyhub service.
service_stop() {
    if _is_test_mode; then
        _ph_log "test mode: skipping systemctl stop proxyhub.service"
        # 测试可观测缝:事件流水供套件断言"停服先于指纹捕获"(issue #93)
        printf 'stop\n' >>"${PROXYHUB_ROOT}/events.log"
        return 0
    fi
    if ! systemctl stop proxyhub.service; then
        _ph_err "failed to stop proxyhub.service"
        return 1
    fi
    return 0
}

# service_start - start the proxyhub service.
service_start() {
    if _is_test_mode; then
        _ph_log "test mode: skipping systemctl start proxyhub.service"
        printf 'start\n' >>"${PROXYHUB_ROOT}/events.log"
        return 0
    fi
    if ! systemctl start proxyhub.service; then
        _ph_err "failed to start proxyhub.service"
        return 1
    fi
    return 0
}

# service_restart - restart the proxyhub service.
service_restart() {
    if _is_test_mode; then
        _ph_log "test mode: skipping systemctl restart proxyhub.service"
        return 0
    fi
    if ! systemctl restart proxyhub.service; then
        _ph_err "failed to restart proxyhub.service"
        return 1
    fi
    return 0
}

# --------------------------------------------------------------------------
# Backup command
# --------------------------------------------------------------------------

# cmd_backup [--protect] - create a timestamped backup archive.
cmd_backup() {
    local protect=0
    while (( $# > 0 )); do
        case "$1" in
            --protect) protect=1; shift ;;
            *) _ph_err "unknown option: $1"; return 2 ;;
        esac
    done

    # Docker caddy mode: the fragment lives on the recorded container's
    # mount; fail closed before stopping the service when it is gone.
    docker_caddy_require_running || return 1

    local timestamp
    timestamp=$(date +%Y%m%d-%H%M%S)
    local random_suffix
    random_suffix=$(random_token 5) || return 1
    local archive_name="proxyhub-backup-${timestamp}-${random_suffix}.tar.gz"
    local backup_dir
    backup_dir=$(root_path "$PROXYHUB_BACKUP_DIR")
    local archive_path="${backup_dir}/${archive_name}"

    _ph_log "creating backup: ${archive_path}"
    _ph_log "stopping service for backup"
    service_stop || return 1

    local auth_key
    auth_key=$(random_token 64) || {
        service_start
        return 1
    }

    local fingerprint_output
    local binary_path
    binary_path=$(root_path "$PROXYHUB_BINARY")
    if [[ ! -x "$binary_path" ]]; then
        _ph_err "proxyhub binary not found: ${binary_path}"
        service_start
        return 1
    fi
    # --config 必传:子命令默认找 CWD 下的 config.yaml,而 proxyhubctl 几乎
    # 从不在 /etc/proxyhub 里被调用(生产首发事故:在 /etc/caddy 下调用即
    # fingerprint capture failed)。
    fingerprint_output=$(printf '%s' "$auth_key" | "$binary_path" state-fingerprint \
        --config "$(root_path "${PROXYHUB_CONFIG_DIR}/config.yaml")" \
        --authentication-key-stdin 2>&1) || {
        _ph_err "fingerprint capture failed"
        service_start
        return 1
    }

    local staging_dir
    staging_dir=$(mktemp -d) || {
        _ph_err "failed to create staging directory"
        service_start
        return 1
    }
    trap "rm -rf $(printf '%q' "$staging_dir"); service_start" EXIT

    # Write fingerprint metadata.
    local meta_file="${staging_dir}/fingerprint.meta"
    {
        printf 'auth_key=%s\n' "$auth_key"
        printf '%s\n' "$fingerprint_output"
    } > "$meta_file" || {
        _ph_err "failed to write fingerprint metadata"
        return 1
    }

    # Copy state, config, Caddy fragment, install info, binary.
    local state_dir config_dir caddy_frag install_info
    state_dir=$(root_path "$PROXYHUB_STATE_DIR")
    config_dir=$(root_path "$PROXYHUB_CONFIG_DIR")
    caddy_frag=$(caddy_managed_config_path) || return 1
    install_info=$(root_path "$PROXYHUB_INSTALL_INFO")

    if [[ -d "$state_dir" ]]; then
        cp -a "$state_dir" "${staging_dir}/state" || {
            _ph_err "failed to copy state directory"
            return 1
        }
    fi
    if [[ -d "$config_dir" ]]; then
        cp -a "$config_dir" "${staging_dir}/config" || {
            _ph_err "failed to copy config directory"
            return 1
        }
    fi
    if [[ -f "$caddy_frag" ]]; then
        mkdir -p "${staging_dir}/caddy"
        cp -a "$caddy_frag" "${staging_dir}/caddy/" || {
            _ph_err "failed to copy Caddy fragment"
            return 1
        }
    fi
    if [[ -f "$install_info" ]]; then
        cp -a "$install_info" "${staging_dir}/" || {
            _ph_err "failed to copy install info"
            return 1
        }
    fi
    if [[ -f "$binary_path" ]]; then
        mkdir -p "${staging_dir}/bin"
        cp -a "$binary_path" "${staging_dir}/bin/" || {
            _ph_err "failed to copy binary"
            return 1
        }
    fi

    # Create the tarball.
    if ! tar -czf "$archive_path" -C "$staging_dir" .; then
        _ph_err "failed to create archive"
        return 1
    fi

    # Mark as protected if requested.
    if (( protect == 1 )); then
        touch "${archive_path}.protected" || {
            _ph_err "failed to mark archive as protected"
            return 1
        }
        _ph_log "archive marked as protected"
    fi

    # Record last backup path.
    local last_backup_path
    last_backup_path=$(root_path "$PROXYHUB_LAST_BACKUP_FILE")
    printf '%s\n' "$archive_path" > "$last_backup_path" || {
        _ph_err "failed to record last backup path"
        return 1
    }

    # Clean up and restart.
    rm -rf "$staging_dir"
    trap - EXIT
    service_start || return 1

    _ph_log "backup complete: ${archive_path}"
    return 0
}

# --------------------------------------------------------------------------
# Restore command
# --------------------------------------------------------------------------

# cmd_restore ARCHIVE [--yes] - restore from a backup archive.
cmd_restore() {
    local archive_path=""
    local confirmed=0
    while (( $# > 0 )); do
        case "$1" in
            --yes) confirmed=1; shift ;;
            -*) _ph_err "unknown option: $1"; return 2 ;;
            *) archive_path="$1"; shift ;;
        esac
    done

    if [[ -z "$archive_path" ]]; then
        _ph_err "usage: proxyhubctl restore ARCHIVE [--yes]"
        return 2
    fi
    if [[ ! -f "$archive_path" ]]; then
        _ph_err "archive not found: ${archive_path}"
        return 1
    fi
    if (( confirmed == 0 )); then
        _ph_err "restore requires --yes confirmation"
        return 2
    fi

    # Docker caddy mode: fail closed before replacing anything when the
    # recorded container is gone (the restored fragment lands on its mount).
    docker_caddy_require_running || return 1

    _ph_log "restoring from: ${archive_path}"

    # Stage extraction.
    local staging_dir
    staging_dir=$(mktemp -d) || {
        _ph_err "failed to create staging directory"
        return 1
    }
    trap "rm -rf $(printf '%q' "$staging_dir")" EXIT

    if ! tar -xzf "$archive_path" -C "$staging_dir"; then
        _ph_err "failed to extract archive"
        return 1
    fi

    # Validate archive structure.
    if [[ ! -f "${staging_dir}/fingerprint.meta" ]]; then
        _ph_err "archive missing fingerprint.meta"
        return 1
    fi

    _ph_log "stopping service for restore"
    service_stop || return 1
    trap "service_start; rm -rf $(printf '%q' "$staging_dir")" EXIT

    # Create rollback snapshot.
    local rollback_dir
    rollback_dir=$(mktemp -d) || {
        _ph_err "failed to create rollback directory"
        return 1
    }

    # Backup current state before replacing.
    local state_dir config_dir caddy_frag install_info binary_path
    state_dir=$(root_path "$PROXYHUB_STATE_DIR")
    config_dir=$(root_path "$PROXYHUB_CONFIG_DIR")
    caddy_frag=$(caddy_managed_config_path) || return 1
    install_info=$(root_path "$PROXYHUB_INSTALL_INFO")
    binary_path=$(root_path "$PROXYHUB_BINARY")

    [[ -d "$state_dir" ]] && cp -a "$state_dir" "${rollback_dir}/state"
    [[ -d "$config_dir" ]] && cp -a "$config_dir" "${rollback_dir}/config"
    [[ -f "$caddy_frag" ]] && { mkdir -p "${rollback_dir}/caddy"; cp -a "$caddy_frag" "${rollback_dir}/caddy/"; }
    [[ -f "$install_info" ]] && cp -a "$install_info" "${rollback_dir}/"
    [[ -f "$binary_path" ]] && { mkdir -p "${rollback_dir}/bin"; cp -a "$binary_path" "${rollback_dir}/bin/"; }

    # Replace each path transactionally.
    local failed=0
    if [[ -d "${staging_dir}/state" ]]; then
        rm -rf "$state_dir"
        if ! cp -a "${staging_dir}/state" "$state_dir"; then
            _ph_err "failed to restore state directory"
            failed=1
        fi
    fi
    if [[ -d "${staging_dir}/config" ]] && (( failed == 0 )); then
        rm -rf "$config_dir"
        if ! cp -a "${staging_dir}/config" "$config_dir"; then
            _ph_err "failed to restore config directory"
            failed=1
        fi
    fi
    if [[ -f "${staging_dir}/caddy/$(basename "$caddy_frag")" ]] && (( failed == 0 )); then
        if ! cp -a "${staging_dir}/caddy/$(basename "$caddy_frag")" "$caddy_frag"; then
            _ph_err "failed to restore Caddy fragment"
            failed=1
        fi
    fi
    if [[ -f "${staging_dir}/.proxyhub-install-info" ]] && (( failed == 0 )); then
        if ! cp -a "${staging_dir}/.proxyhub-install-info" "$install_info"; then
            _ph_err "failed to restore install info"
            failed=1
        fi
    fi
    if [[ -f "${staging_dir}/bin/proxyhub" ]] && (( failed == 0 )); then
        if ! cp -a "${staging_dir}/bin/proxyhub" "$binary_path"; then
            _ph_err "failed to restore binary"
            failed=1
        fi
        chmod +x "$binary_path"
    fi

    # Validate Caddy config.
    if (( failed == 0 )) && [[ -f "$caddy_frag" ]]; then
        if ! _is_test_mode; then
            if ! caddy_fmt "$caddy_frag" 2>&1; then
                _ph_err "Caddy format validation failed"
                failed=1
            elif ! caddy_validate /etc/caddy/Caddyfile 2>&1; then
                _ph_err "Caddy validate failed"
                failed=1
            fi
        fi
    fi

    # Rollback on failure.
    if (( failed == 1 )); then
        _ph_err "restore failed, rolling back"
        [[ -d "${rollback_dir}/state" ]] && { rm -rf "$state_dir"; cp -a "${rollback_dir}/state" "$state_dir"; }
        [[ -d "${rollback_dir}/config" ]] && { rm -rf "$config_dir"; cp -a "${rollback_dir}/config" "$config_dir"; }
        [[ -f "${rollback_dir}/caddy/$(basename "$caddy_frag")" ]] && cp -a "${rollback_dir}/caddy/$(basename "$caddy_frag")" "$caddy_frag"
        [[ -f "${rollback_dir}/.proxyhub-install-info" ]] && cp -a "${rollback_dir}/.proxyhub-install-info" "$install_info"
        [[ -f "${rollback_dir}/bin/proxyhub" ]] && cp -a "${rollback_dir}/bin/proxyhub" "$binary_path"

        local rollback_archive
        rollback_archive="${backup_dir}/rollback-$(date +%Y%m%d-%H%M%S).tar.gz"
        tar -czf "$rollback_archive" -C "$rollback_dir" . || true
        _ph_err "rollback snapshot saved: ${rollback_archive}"
        rm -rf "$rollback_dir"
        service_start
        return 1
    fi

    # Reload Caddy if not in test mode.
    if ! _is_test_mode && [[ -f "$caddy_frag" ]]; then
        if ! caddy_reload; then
            _ph_err "Caddy reload failed"
            failed=1
        fi
    fi

    # Restart service and health check.
    service_start || {
        _ph_err "failed to start service after restore"
        return 1
    }

    # Simple health check: wait for service to be active.
    if ! _is_test_mode; then
        sleep 2
        if ! systemctl is-active --quiet proxyhub.service; then
            _ph_err "service health check failed"
            return 1
        fi
    fi

    rm -rf "$rollback_dir" "$staging_dir"
    trap - EXIT

    _ph_log "restore complete"
    return 0
}

# --------------------------------------------------------------------------
# Rotate-path command
# --------------------------------------------------------------------------

# cmd_rotate_path [PATH] [--yes] - rotate to a new Site Path.
cmd_rotate_path() {
    local new_path=""
    local confirmed=0
    while (( $# > 0 )); do
        case "$1" in
            --yes) confirmed=1; shift ;;
            -*) _ph_err "unknown option: $1"; return 2 ;;
            *) new_path="$1"; shift ;;
        esac
    done

    if (( confirmed == 0 )); then
        _ph_err "rotate-path is a high-risk operation requiring --yes confirmation"
        return 2
    fi

    # Generate new Site Path if not provided. random_token draws from the full
    # [A-Za-z0-9_-] charset, so a single draw fails validate_site_path ~1.6% of
    # the time (too few character classes, or a reserved-word substring).
    # Resample until one validates, mirroring install.sh's _obtain_site_path;
    # bound the attempts so a broken PRNG cannot loop forever.
    if [[ -z "$new_path" ]]; then
        local attempts=0
        while (( attempts < 100 )); do
            new_path=$(random_token 20) || {
                _ph_err "failed to generate new Site Path"
                return 1
            }
            validate_site_path "$new_path" >/dev/null 2>&1 && break
            attempts=$((attempts + 1))
        done
        if (( attempts >= 100 )); then
            _ph_err "failed to generate a valid Site Path after 100 attempts"
            return 1
        fi
    fi

    # Validate new Site Path (also covers operator-provided paths).
    if ! validate_site_path "$new_path"; then
        _ph_err "invalid Site Path: ${new_path}"
        return 1
    fi

    # Read current install info.
    local install_info
    install_info=$(root_path "$PROXYHUB_INSTALL_INFO")
    if [[ ! -f "$install_info" ]]; then
        _ph_err "install info not found: ${install_info}"
        return 1
    fi

    # Extract current domain and Site Path.
    local domain old_path
    domain=$(sed -n 's/^DOMAIN=//p' "$install_info")
    old_path=$(sed -n 's/^SITE_PATH=//p' "$install_info")
    if [[ -z "$domain" ]] || [[ -z "$old_path" ]]; then
        _ph_err "failed to read domain or Site Path from install info"
        return 1
    fi

    # --no-caddy installs have no managed fragment to rotate; the operator's
    # own reverse proxy holds the path, which we must not rewrite.
    if [[ $(sed -n 's/^NO_CADDY=//p' "$install_info") == 1 ]]; then
        _ph_err "this install uses --no-caddy: rotate-path cannot rewrite your own reverse proxy config"
        _ph_err "update the Site Path in your proxy (see /etc/proxyhub/reverse-proxy.* examples) instead"
        return 1
    fi

    _ph_log "rotating Site Path from ${old_path} to ${new_path}"

    # Docker caddy mode: verify the recorded container is alive, then
    # re-derive the reach-back topology from the live container (gateway and
    # subnet are deliberately NOT recorded; they drift when the container is
    # recreated). write_caddy_fragment only emits the bridge upstream
    # (host.docker.internal:PORT) after prepare_topology ran.
    docker_caddy_require_running || return 1
    if [[ $PROXYHUB_CADDY_MODE == docker ]]; then
        docker_caddy_prepare_topology "$PROXYHUB_CADDY_CONTAINER" || return 1
    fi

    # Backup current Caddy fragment for rollback.
    local caddy_frag
    caddy_frag=$(caddy_managed_config_path) || return 1
    local rollback_frag="${caddy_frag}.rollback.$$"
    if [[ -f "$caddy_frag" ]]; then
        cp -a "$caddy_frag" "$rollback_frag" || {
            _ph_err "failed to backup Caddy fragment"
            return 1
        }
    fi
    trap "rm -f $(printf '%q' "$rollback_frag")" EXIT

    # Write new Caddy fragment.
    if ! write_caddy_fragment "$domain" "$new_path"; then
        _ph_err "failed to write new Caddy fragment"
        # File layout: an in-place write may have truncated the Caddyfile;
        # the rollback copy taken before the write restores it.
        if [[ -f "$rollback_frag" ]]; then
            cp -a "$rollback_frag" "$caddy_frag" || true
        fi
        return 1
    fi

    # Validate and reload Caddy.
    if ! _is_test_mode; then
        if ! caddy_fmt "$caddy_frag" 2>&1; then
            _ph_err "Caddy format validation failed, rolling back"
            [[ -f "$rollback_frag" ]] && cp -a "$rollback_frag" "$caddy_frag"
            return 1
        fi
        if ! caddy_validate /etc/caddy/Caddyfile 2>&1; then
            _ph_err "Caddy validate failed, rolling back"
            [[ -f "$rollback_frag" ]] && cp -a "$rollback_frag" "$caddy_frag"
            return 1
        fi
        if ! caddy_reload; then
            _ph_err "Caddy reload failed, rolling back"
            [[ -f "$rollback_frag" ]] && cp -a "$rollback_frag" "$caddy_frag"
            return 1
        fi
        _ph_log "Caddy reloaded successfully"
    fi

    # Update install info with new Site Path.
    local tmp_info="${install_info}.tmp.$$"
    if ! sed "s|^SITE_PATH=.*|SITE_PATH=${new_path}|" "$install_info" > "$tmp_info"; then
        _ph_err "failed to update install info"
        [[ -f "$rollback_frag" ]] && cp -a "$rollback_frag" "$caddy_frag"
        _is_test_mode || caddy_reload || true
        rm -f "$tmp_info"
        return 1
    fi
    if ! mv "$tmp_info" "$install_info"; then
        _ph_err "failed to install updated install info"
        [[ -f "$rollback_frag" ]] && cp -a "$rollback_frag" "$caddy_frag"
        _is_test_mode || caddy_reload || true
        rm -f "$tmp_info"
        return 1
    fi

    rm -f "$rollback_frag"
    trap - EXIT

    _ph_log "Site Path rotated successfully"
    _ph_log "New management URL: https://${domain}/${new_path}/"
    return 0
}

# --------------------------------------------------------------------------
# Update command
# --------------------------------------------------------------------------

# _capture_state_fingerprint BINARY AUTH_KEY - print the binary's retained-state
# fingerprint with volatile lines (timestamp) stripped, so two captures are
# comparable. The auth key travels only through the stdin pipe.
_capture_state_fingerprint() {
    local binary="$1"
    local auth_key="$2"
    local config_path
    config_path=$(root_path "${PROXYHUB_CONFIG_DIR}/config.yaml")
    printf '%s' "$auth_key" | "$binary" state-fingerprint \
        --authentication-key-stdin --config "$config_path" 2>&1 \
        | grep -v '^timestamp'
}

# _rollback_update_state - restore the state directory from the pre-update
# backup on update rollback (issue #93). The pre-swap fingerprint capture runs
# the new binary's migrations in place (store.Open migrates unconditionally),
# so rolling back only the binary would strand it on a migrated (newer-schema)
# database. Every rollback path therefore restores binary AND state together,
# returning the installation to the exact pre-update generation. A restore
# failure is loud, never silent: the operator is pointed at the backup archive
# for manual recovery.
_rollback_update_state() {
    local archive state_dir staging
    archive=$(cat "$(root_path "$PROXYHUB_LAST_BACKUP_FILE")" 2>/dev/null || true)
    state_dir=$(root_path "$PROXYHUB_STATE_DIR")
    if [[ -z "$archive" || ! -f "$archive" ]]; then
        _ph_err "rollback: pre-update backup archive not found; restore the state directory manually"
        return 1
    fi
    staging=$(mktemp -d) || return 1
    if ! tar -xzf "$archive" -C "$staging" ./state || [[ ! -d "${staging}/state" ]]; then
        _ph_err "rollback: no state directory in ${archive}; restore it manually"
        rm -rf "$staging"
        return 1
    fi
    # Swap, don't overwrite in place: a failed copy must not leave a half-restored dir.
    local aside="${state_dir}.rollback-$$"
    rm -rf "$aside"
    if ! mv "$state_dir" "$aside"; then
        _ph_err "rollback: failed to set aside current state directory; restore ${archive} manually"
        rm -rf "$staging"
        return 1
    fi
    if ! cp -a "${staging}/state" "$state_dir"; then
        _ph_err "rollback: state copy failed; attempting to move the previous directory back"
        # cp may have left a half-created $state_dir; remove it so mv restores
        # the previous directory in place instead of nesting inside it.
        rm -rf "$state_dir"
        if mv "$aside" "$state_dir"; then
            _ph_err "rollback: previous state directory restored; recover manually from ${archive}"
        else
            _ph_err "rollback: previous state directory left at ${aside}; recover manually from ${archive}"
        fi
        rm -rf "$staging"
        return 1
    fi
    rm -rf "$aside" "$staging"
    _ph_log "rollback: state directory restored from pre-update backup ${archive}"
    return 0
}

# _read_install_field KEY - read one KEY=value field from the install record.
_read_install_field() {
    local install_info
    install_info=$(root_path "$PROXYHUB_INSTALL_INFO")
    sed -n "s/^$1=//p" "$install_info" 2>/dev/null | head -1
}

# _detect_os_arch - print "OS ARCH" for release asset naming.
_detect_os_arch() {
    local os arch
    case "$(uname -s)" in
        Linux) os=linux ;;
        Darwin) os=darwin ;;
        *) _ph_err "unsupported kernel '$(uname -s)'"; return 1 ;;
    esac
    case "$(uname -m)" in
        x86_64) arch=amd64 ;;
        aarch64 | arm64) arch=arm64 ;;
        *) _ph_err "unsupported architecture '$(uname -m)'"; return 1 ;;
    esac
    printf '%s %s' "$os" "$arch"
}

# cmd_update [VERSION] [--version VERSION] [--yes] [--prerelease] [--stable-only]
#            [--download-base URL]
# Guarded update: backup first, download + minisign signature + SHA256
# double-gate verification (ADR 0036), swap the binary, verify the
# retained-state fingerprint with the new binary, restart; roll back to the
# previous binary on any failure after the swap.
cmd_update() {
    local target="" confirmed=0 allow_prerelease=0 stable_only=0
    local download_base_arg=""
    while (( $# > 0 )); do
        case "$1" in
            --yes) confirmed=1; shift ;;
            --prerelease) allow_prerelease=1; shift ;;
            --stable-only) stable_only=1; shift ;;
            --version)
                (( $# >= 2 )) || { _ph_err "--version requires a value"; return 2; }
                target="$2"; shift 2 ;;
            --download-base)
                (( $# >= 2 )) || { _ph_err "--download-base requires a value"; return 2; }
                download_base_arg="$2"; shift 2 ;;
            --download-base=*) download_base_arg="${1#--download-base=}"; shift ;;
            -*) _ph_err "unknown option: $1"; return 2 ;;
            *) target="$1"; shift ;;
        esac
    done

    local install_info
    install_info=$(root_path "$PROXYHUB_INSTALL_INFO")
    if [[ ! -f "$install_info" ]]; then
        _ph_err "install info not found: ${install_info} (not a managed install?)"
        return 1
    fi
    local repo current_version
    repo=$(_read_install_field REPO)
    current_version=$(_read_install_field VERSION)
    repo="${repo:-taliove/proxyhub}"
    if [[ -z "$current_version" ]]; then
        _ph_err "failed to read current VERSION from ${install_info}"
        return 1
    fi

    # Effective download base (ADR 0036): an explicit --download-base wins
    # over the install record's DOWNLOAD_BASE; records predating the field
    # fall back to the official GitHub releases base. An invalid flag value
    # is a usage error (rc 2); a corrupt record value is an operational
    # failure (rc 1).
    local record_base download_base
    record_base=$(_read_install_field DOWNLOAD_BASE)
    if [[ -n $download_base_arg ]]; then
        download_base=$(resolve_download_base "$repo" "$download_base_arg") || return 2
    else
        download_base=$(resolve_download_base "$repo" "$record_base") || return 1
    fi

    # Resolve the target version: explicit argument, or the latest release.
    # Latest walks the two-channel chain (GitHub redirect, then the jsDelivr
    # data API - ADR 0037), so mirror-mode updates without an explicit
    # version work wherever jsDelivr is reachable. Both channels return
    # stable releases only, so the name-shape check alone gates prereleases.
    if [[ -z "$target" ]]; then
        target=$(resolve_latest_version "$repo") || return 1
    fi
    validate_version "$target" || return 1
    target="v${target#v}"

    # Prerelease gating: explicit --prerelease required; --stable-only never
    # allows prereleases (used by the unattended auto-update timer).
    local is_prerelease=0
    if [[ "$target" == *-* ]]; then
        is_prerelease=1
    fi
    if (( is_prerelease == 1 && stable_only == 1 )); then
        _ph_err "${target} is a prerelease; --stable-only rejects prereleases"
        return 2
    fi
    if (( is_prerelease == 1 && allow_prerelease == 0 )); then
        _ph_err "${target} is a prerelease; re-run with --prerelease to install it"
        return 2
    fi

    if [[ "$target" == "$current_version" ]]; then
        _ph_log "already at version ${current_version}; nothing to do"
        return 0
    fi

    if (( confirmed == 0 )) && ! _is_test_mode; then
        _ph_err "update to ${target} requires --yes confirmation"
        return 2
    fi

    _ph_log "updating ProxyHub ${current_version} -> ${target}"

    # Docker caddy mode: the pre-update backup copies the fragment off the
    # recorded container's mount; fail closed here, before the service stop.
    docker_caddy_require_running || return 1

    # Backup BEFORE touching anything (also stops/starts the service).
    _ph_log "creating pre-update backup"
    if ! cmd_backup; then
        _ph_err "pre-update backup failed; aborting update"
        return 1
    fi

    local os_arch os arch
    os_arch=$(_detect_os_arch) || return 1
    os="${os_arch% *}"
    arch="${os_arch#* }"
    # Asset naming must match scripts/release/package.sh (underscores).
    local asset="proxyhub_${target#v}_${os}_${arch}.tar.gz"
    local base="${download_base}/${target}"

    local workdir
    workdir=$(mktemp -d) || {
        _ph_err "failed to create update workspace"
        return 1
    }
    trap "rm -rf $(printf '%q' "$workdir")" EXIT

    _ph_log "downloading ${base}/${asset}"
    if ! curl -fsSL --max-time 60 -o "${workdir}/SHA256SUMS" "${base}/SHA256SUMS"; then
        _ph_err "failed to download SHA256SUMS for ${target}"
        return 1
    fi
    # Signature trust anchor (ADR 0036): verify the minisign signature over
    # SHA256SUMS before trusting any checksum in it. A missing or failing
    # signature refuses the download here, before the live binary is touched
    # (the pre-update backup rollback path is never reached).
    if ! curl -fsSL --max-time 60 -o "${workdir}/SHA256SUMS.minisig" "${base}/SHA256SUMS.minisig"; then
        _ph_err "failed to download SHA256SUMS.minisig for ${target}; refusing to update (current installation untouched)"
        return 1
    fi
    verify_minisig "${workdir}/SHA256SUMS" "${workdir}/SHA256SUMS.minisig" || return 1
    if ! curl -fsSL --max-time 300 -o "${workdir}/${asset}" "${base}/${asset}"; then
        _ph_err "failed to download ${asset}"
        return 1
    fi

    _ph_log "verifying SHA256 checksum of ${asset}"
    # The release SHA256SUMS lists every matrix target; verify ONLY the line
    # for the asset we downloaded (mirrors install.sh). A full-manifest
    # sha256sum -c would fail on the assets we did not download.
    local line_file="${workdir}/.checksum-line"
    grep -F -- "$asset" "${workdir}/SHA256SUMS" \
        | grep -E '^[0-9a-fA-F]{64}[[:space:]]+[^[:space:]]+$' > "$line_file" || true
    if [[ $(wc -l < "$line_file" | tr -d ' ') != "1" ]]; then
        _ph_err "SHA256SUMS does not contain exactly one entry for ${asset}; refusing to update"
        return 1
    fi
    if ! (cd "$workdir" && sha256sum -c "$line_file" >/dev/null 2>&1); then
        _ph_err "checksum verification failed for ${asset}; refusing to update (current installation untouched)"
        return 1
    fi

    mkdir -p "${workdir}/extract"
    if ! tar -xzf "${workdir}/${asset}" -C "${workdir}/extract"; then
        _ph_err "failed to unpack ${asset}"
        return 1
    fi
    if [[ ! -f "${workdir}/extract/proxyhub" ]]; then
        _ph_err "${asset} does not contain the proxyhub binary"
        return 1
    fi
    chmod +x "${workdir}/extract/proxyhub"

    # Pre-swap fingerprint(issue #92):新旧二进制各自对当前 DB 取指纹。
    # 跨版本全等只作建议性报告,不作硬门——摘要输入随版本合法演进(如 0.9.0
    # 把 grpc_authority 纳入自建节点摘要),迁移也可能合法改写记录(如 023 去重
    # 删行);把可预期差异误判为"数据丢失"会锁死升级。真正的硬门是下方
    # 同二进制 pre/post-swap 比对;差异由升级前备份兜底。
    #
    # 先停服再捕获(issue #93):新二进制的捕获会原地执行迁移(store.Open 无条件
    # migrate)——旧服务运行期间改库是竞态窗口,且迁移一旦执行,后续回滚必须
    # 连同状态目录一起还原(_rollback_update_state)。捕获/迁移/交换全部收敛到
    # 服务停止窗口内。
    local binary_path auth_key old_fp new_fp
    binary_path=$(root_path "$PROXYHUB_BINARY")
    if [[ ! -x "$binary_path" ]]; then
        _ph_err "current proxyhub binary not found: ${binary_path}"
        return 1
    fi
    # Stage the current binary for rollback before stopping the service.
    cp -a "$binary_path" "${workdir}/proxyhub.old" || {
        _ph_err "failed to stage current binary for rollback"
        return 1
    }
    _ph_log "stopping service for fingerprint capture and binary swap"
    service_stop || return 1
    trap "service_start; rm -rf $(printf '%q' "$workdir")" EXIT

    auth_key=$(random_token 64) || return 1
    old_fp=$(_capture_state_fingerprint "$binary_path" "$auth_key") || {
        _ph_err "state fingerprint capture failed on current binary"
        return 1
    }
    new_fp=$(_capture_state_fingerprint "${workdir}/extract/proxyhub" "$auth_key") || {
        _ph_err "state fingerprint capture failed on new binary"
        return 1
    }
    if [[ "$old_fp" == "$new_fp" ]]; then
        _ph_log "state fingerprint identical across versions"
    else
        _ph_warn "state fingerprint differs across versions (digest inputs or migration transforms changed between ${current_version} and ${target})"
        # 计数级差异可见性:行数变化是迁移改写的最直观信号,贴出来供人工核对
        local counts_diff
        counts_diff=$(diff <(grep '^[a-z_]*_count' <<<"$old_fp") <(grep '^[a-z_]*_count' <<<"$new_fp") || true)
        if [[ -n "$counts_diff" ]]; then
            _ph_warn "row-count changes (pre-update backup covers this):"
            printf '%s\n' "$counts_diff" >&2
        fi
    fi

    if ! install -m 0755 "${workdir}/extract/proxyhub" "$binary_path"; then
        _ph_err "failed to install new binary; restoring previous binary and pre-update state"
        cp -a "${workdir}/proxyhub.old" "$binary_path" || true
        _rollback_update_state || _ph_err "state restore failed; recover manually from the pre-update backup above"
        service_start
        return 1
    fi

    # Post-swap fingerprint(硬门,issue #92):同一个新二进制在原地迁移后(pre-swap
    # 捕获)与安装落位后必须看到完全相同的状态——证明 swap 零损坏。比对基准是
    # new_fp(新二进制自己),不是 old_fp(跨版本摘要可能合法不同)。
    local installed_fp
    installed_fp=$(_capture_state_fingerprint "$binary_path" "$auth_key") || true
    if [[ "$installed_fp" != "$new_fp" ]]; then
        _ph_err "post-update state fingerprint mismatch (same binary pre/post swap); rolling back to ${current_version}"
        cp -a "${workdir}/proxyhub.old" "$binary_path" || true
        # 回滚连同状态目录(issue #93):pre-swap 捕获已把迁移原地跑掉,
        # 只还原二进制会把旧版本留在新 schema 的库上
        _rollback_update_state || _ph_err "state restore failed; recover manually from the pre-update backup above"
        service_start
        return 1
    fi

    # Record the new version only after every verification passed.
    local tmp_info="${install_info}.tmp.$$"
    if ! sed "s|^VERSION=.*|VERSION=${target}|" "$install_info" > "$tmp_info" ||
        ! mv "$tmp_info" "$install_info"; then
        _ph_err "failed to update install record; rolling back to ${current_version}"
        rm -f "$tmp_info"
        cp -a "${workdir}/proxyhub.old" "$binary_path" || true
        _rollback_update_state || _ph_err "state restore failed; recover manually from the pre-update backup above"
        service_start
        return 1
    fi

    service_start || {
        _ph_err "failed to start service after update"
        return 1
    }
    if ! _is_test_mode; then
        sleep 2
        if ! systemctl is-active --quiet proxyhub.service; then
            _ph_err "service health check failed after update"
            return 1
        fi
    fi

    rm -rf "$workdir"
    trap - EXIT

    _ph_log "update complete: ${current_version} -> ${target}"
    return 0
}

# --------------------------------------------------------------------------
# Auto-update commands
# --------------------------------------------------------------------------

readonly PROXYHUB_AUTO_UPDATE_TIMER="/etc/systemd/system/proxyhub-auto-update.timer"
readonly PROXYHUB_AUTO_UPDATE_SERVICE="/etc/systemd/system/proxyhub-auto-update.service"

# cmd_enable_auto_update - install and enable the auto-update timer.
cmd_enable_auto_update() {
    local timer_path service_path
    timer_path=$(root_path "$PROXYHUB_AUTO_UPDATE_TIMER")
    service_path=$(root_path "$PROXYHUB_AUTO_UPDATE_SERVICE")

    # Write the service unit.
    local tmp_service="${service_path}.tmp.$$"
    cat > "$tmp_service" <<'EOF'
[Unit]
Description=ProxyHub auto-update (stable channel only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/proxyhubctl update --yes --stable-only
EOF
    if ! chmod 0644 "$tmp_service"; then
        _ph_err "failed to chmod service unit"
        rm -f "$tmp_service"
        return 1
    fi
    if ! mv "$tmp_service" "$service_path"; then
        _ph_err "failed to install service unit"
        rm -f "$tmp_service"
        return 1
    fi
    _ph_log "wrote ${service_path}"

    # Write the timer unit (Sunday 03:17).
    local tmp_timer="${timer_path}.tmp.$$"
    cat > "$tmp_timer" <<'EOF'
[Unit]
Description=Weekly ProxyHub auto-update timer
Requires=proxyhub-auto-update.service

[Timer]
OnCalendar=Sun *-*-* 03:17:00
Persistent=true

[Install]
WantedBy=timers.target
EOF
    if ! chmod 0644 "$tmp_timer"; then
        _ph_err "failed to chmod timer unit"
        rm -f "$tmp_timer"
        return 1
    fi
    if ! mv "$tmp_timer" "$timer_path"; then
        _ph_err "failed to install timer unit"
        rm -f "$tmp_timer"
        return 1
    fi
    _ph_log "wrote ${timer_path}"

    # Enable and start the timer.
    if ! _is_test_mode; then
        systemctl daemon-reload || {
            _ph_err "systemctl daemon-reload failed"
            return 1
        }
        systemctl enable proxyhub-auto-update.timer || {
            _ph_err "failed to enable timer"
            return 1
        }
        systemctl start proxyhub-auto-update.timer || {
            _ph_err "failed to start timer"
            return 1
        }
    fi

    _ph_log "auto-update timer enabled (runs weekly on Sunday at 03:17 UTC)"
    return 0
}

# cmd_disable_auto_update - disable and remove the auto-update timer.
cmd_disable_auto_update() {
    local timer_path service_path
    timer_path=$(root_path "$PROXYHUB_AUTO_UPDATE_TIMER")
    service_path=$(root_path "$PROXYHUB_AUTO_UPDATE_SERVICE")

    # Stop and disable the timer.
    if ! _is_test_mode; then
        systemctl stop proxyhub-auto-update.timer 2>/dev/null || true
        systemctl disable proxyhub-auto-update.timer 2>/dev/null || true
    fi

    # Remove unit files.
    rm -f "$timer_path" "$service_path"
    _ph_log "removed auto-update timer and service units"

    if ! _is_test_mode; then
        systemctl daemon-reload || true
    fi

    _ph_log "auto-update disabled"
    return 0
}

# --------------------------------------------------------------------------
# Uninstall command
# --------------------------------------------------------------------------

# cmd_uninstall [--purge] [--yes] - remove ProxyHub installation.
cmd_uninstall() {
    local purge=0
    local confirmed=0
    while (( $# > 0 )); do
        case "$1" in
            --purge) purge=1; shift ;;
            --yes) confirmed=1; shift ;;
            *) _ph_err "unknown option: $1"; return 2 ;;
        esac
    done

    if (( confirmed == 0 )); then
        _ph_err "uninstall is a high-risk operation requiring --yes confirmation"
        return 2
    fi

    # Docker caddy mode: fail closed even for cleanup - the fragment lives on
    # the recorded container's mount, and silently skipping its removal would
    # leave a stale route if the container comes back.
    if ! docker_caddy_require_running; then
        _ph_err "if the container was removed together with the caddy deployment, the fragment mount may already be gone; verify manually, then remove the install record"
        return 1
    fi

    _ph_log "uninstalling ProxyHub"

    # Stop and disable services.
    if ! _is_test_mode; then
        systemctl stop proxyhub.service 2>/dev/null || true
        systemctl disable proxyhub.service 2>/dev/null || true
        systemctl stop proxyhub-auto-update.timer 2>/dev/null || true
        systemctl disable proxyhub-auto-update.timer 2>/dev/null || true
    fi

    # Remove systemd units.
    local unit_path timer_path service_path
    unit_path=$(root_path "$PROXYHUB_UNIT_PATH")
    timer_path=$(root_path "$PROXYHUB_AUTO_UPDATE_TIMER")
    service_path=$(root_path "$PROXYHUB_AUTO_UPDATE_SERVICE")
    rm -f "$unit_path" "$timer_path" "$service_path"
    _ph_log "removed systemd units"

    if ! _is_test_mode; then
        systemctl daemon-reload || true
    fi

    # Remove the managed Caddy config and reload. File layout: splice the
    # managed block OUT of the Caddyfile (never delete the operator's file).
    # Everything else: delete the fragment, keep the import line.
    local layout_handled=0
    if [[ $PROXYHUB_CADDY_MODE == docker ]]; then
        _caddy_docker_layout || return 1
        if [[ $PROXYHUB_CADDY_LAYOUT == file ]]; then
            layout_handled=1
            if ! remove_caddy_siteblock; then
                _ph_err "managed site block NOT removed from the Caddyfile; the stale route may still be live - remove it manually"
                return 1
            fi
            _ph_log "removed managed site block from the Caddyfile"
            _is_test_mode || caddy_reload >/dev/null 2>&1 || true
        fi
    fi
    if ((layout_handled == 0)); then
        local caddy_frag
        caddy_frag=$(caddy_managed_config_path) || return 1
        if [[ -f "$caddy_frag" ]]; then
            rm -f "$caddy_frag"
            _ph_log "removed Caddy fragment"
            if ! _is_test_mode; then
                # Best-effort: with 'admin off' a plain reload silently no-ops and
                # the stale route would survive until the next Caddy restart.
                caddy_reload >/dev/null 2>&1 || true
            fi
        fi
    fi

    # Remove binary.
    local binary_path
    binary_path=$(root_path "$PROXYHUB_BINARY")
    if [[ -f "$binary_path" ]]; then
        rm -f "$binary_path"
        _ph_log "removed binary: ${binary_path}"
    fi

    # Remove the operator CLI helper library (already sourced into memory, so
    # this is safe). proxyhubctl itself is removed by the operator after this
    # command exits: bash reads the running script incrementally, so it must
    # not delete itself here.
    local ctl_lib
    ctl_lib=$(root_path /usr/local/bin/proxyhubctl-lib.sh)
    if [[ -f "$ctl_lib" ]]; then
        rm -f "$ctl_lib"
        _ph_log "removed ${ctl_lib}"
        _ph_log "NOTE: remove /usr/local/bin/proxyhubctl manually after this command exits"
    fi

    # Remove config and log directories.
    local config_dir log_dir
    config_dir=$(root_path "$PROXYHUB_CONFIG_DIR")
    log_dir=$(root_path "$PROXYHUB_LOG_DIR")
    rm -rf "$config_dir"
    rm -rf "$log_dir"
    _ph_log "removed config and log directories"

    # Purge state and backups if requested.
    if (( purge == 1 )); then
        _ph_log "purging state and backups (--purge flag set)"

        # Create final recovery archive before purging.
        local backup_dir
        backup_dir=$(root_path "$PROXYHUB_BACKUP_DIR")
        local recovery_archive="${backup_dir}/final-recovery-$(date +%Y%m%d-%H%M%S).tar.gz"
        if [[ -d "$backup_dir" ]]; then
            mkdir -p "$(dirname "$recovery_archive")"
            tar -czf "$recovery_archive" -C "$backup_dir" . 2>/dev/null || true
            _ph_log "created final recovery archive: ${recovery_archive}"
        fi

        local state_dir install_info
        state_dir=$(root_path "$PROXYHUB_STATE_DIR")
        install_info=$(root_path "$PROXYHUB_INSTALL_INFO")

        rm -rf "$state_dir"
        rm -rf "$backup_dir"
        rm -f "$install_info"
        _ph_log "purged state, backups, and install record"

        # Remove the service identity: purge means complete removal. The
        # service is already stopped; deletion failures (foreign processes)
        # are tolerated so purge cannot be blocked by a stray login session.
        if ! _is_test_mode; then
            id "$PROXYHUB_USER" >/dev/null 2>&1 && userdel "$PROXYHUB_USER" 2>/dev/null || true
            getent group "$PROXYHUB_GROUP" >/dev/null 2>&1 && groupdel "$PROXYHUB_GROUP" 2>/dev/null || true
            _ph_log "removed service user/group"
        fi
    else
        _ph_log "preserved state, backups, and install record (use --purge to remove)"
    fi

    _ph_log "uninstall complete"
    return 0
}

# --------------------------------------------------------------------------
# reset-mfa command
# --------------------------------------------------------------------------

# cmd_reset_mfa --username NAME [--yes] - clear one account's MFA enrollment.
#
# Self-rescue channel for a lost TOTP device: delegates to the main binary's
# reset-mfa subcommand, which opens the database directly. Reaching this shell
# already means root on the box, so the guard here is against a mistyped
# account, not against an attacker.
#
# Confirmation mirrors uninstall: --yes skips the prompt (required for
# non-interactive callers), otherwise the operator must type "yes". A declined
# or non-interactive prompt aborts without touching the database.
cmd_reset_mfa() {
    local username="" confirmed=0
    while (( $# > 0 )); do
        case "$1" in
            --yes) confirmed=1; shift ;;
            --username)
                (( $# >= 2 )) || { _ph_err "--username requires a value"; return 2; }
                username="$2"; shift 2 ;;
            --username=*) username="${1#--username=}"; shift ;;
            -*) _ph_err "unknown option: $1"; return 2 ;;
            *) _ph_err "unexpected argument: $1"; return 2 ;;
        esac
    done

    if [[ -z "$username" ]]; then
        _ph_err "reset-mfa requires --username NAME"
        return 2
    fi

    local binary_path config_path
    binary_path=$(root_path "$PROXYHUB_BINARY")
    config_path=$(root_path "${PROXYHUB_CONFIG_DIR}/config.yaml")
    if [[ ! -x "$binary_path" ]]; then
        _ph_err "proxyhub binary not found: ${binary_path}"
        return 1
    fi

    if (( confirmed == 0 )); then
        _ph_log "reset-mfa clears the TOTP secret and every recovery code of user '${username}'"
        _ph_log "the account must enroll a new authenticator on its next login"
        local answer=""
        # Prompt on stderr so the confirmation text never pollutes stdout.
        printf '[proxyhub] type "yes" to reset MFA for %s: ' "$username" >&2
        read -r answer || answer=""
        if [[ "$answer" != "yes" ]]; then
            _ph_err "reset-mfa aborted: no changes made"
            return 1
        fi
    fi

    if ! "$binary_path" reset-mfa --config "$config_path" --username "$username"; then
        _ph_err "reset-mfa failed for user '${username}'"
        return 1
    fi

    _ph_log "MFA reset for user '${username}'"
    return 0
}

# --------------------------------------------------------------------------
# Main command dispatcher
# --------------------------------------------------------------------------

# cmd_status - show service state and the management URL.
cmd_status() {
    local state
    state=$(systemctl is-active proxyhub.service 2>/dev/null) || true
    state="${state:-unknown}"

    local domain site_path version
    domain=$(_read_install_field DOMAIN)
    site_path=$(_read_install_field SITE_PATH)
    version=$(_read_install_field VERSION)

    # Effective download base (ADR 0036): the recorded DOWNLOAD_BASE, or the
    # official GitHub releases base for records predating the field.
    local repo download_base
    repo=$(_read_install_field REPO)
    repo="${repo:-taliove/proxyhub}"
    download_base=$(_read_install_field DOWNLOAD_BASE)
    download_base="${download_base:-$(default_download_base "$repo")}"

    printf 'ProxyHub Status\n'
    printf '===============\n'
    printf 'Service state: %s\n' "$state"
    printf 'Version:       %s\n' "${version:-unknown}"
    printf 'Download base: %s\n' "$download_base"
    if [[ -n "$domain" ]] && [[ -n "$site_path" ]]; then
        printf 'Management URL: https://%s/%s/\n' "$domain" "$site_path"
    else
        printf 'Management URL: unknown (install record missing)\n'
    fi
    return 0
}

# cmd_logs [--follow] [--lines N] - show service logs via journalctl.
cmd_logs() {
    local follow=0 lines=50
    while (( $# > 0 )); do
        case "$1" in
            --follow) follow=1; shift ;;
            --lines)
                (( $# >= 2 )) || { _ph_err "--lines requires a value"; return 2; }
                lines="$2"; shift 2 ;;
            *) _ph_err "unknown option: $1"; return 2 ;;
        esac
    done

    local -a args=(-u proxyhub.service -n "$lines" --no-pager)
    if (( follow == 1 )); then
        args+=(-f)
    fi
    journalctl "${args[@]}"
}

# cmd_restart - restart the service and verify it comes back healthy.
cmd_restart() {
    _ph_log "restarting proxyhub.service"
    service_restart || return 1
    if _is_test_mode; then
        _ph_log "service is healthy"
        return 0
    fi
    sleep 2
    if systemctl is-active --quiet proxyhub.service; then
        _ph_log "service is healthy"
        return 0
    fi
    _ph_err "service failed health check after restart"
    return 1
}

# cmd_show_info - print the install record (never contains the password).
cmd_show_info() {
    local install_info
    install_info=$(root_path "$PROXYHUB_INSTALL_INFO")
    if [[ ! -f "$install_info" ]]; then
        _ph_err "install info not found: ${install_info} (not a managed install?)"
        return 1
    fi
    cat "$install_info"
}

# usage - print usage information.
usage() {
    cat >&2 <<EOF
USAGE: proxyhubctl COMMAND [OPTIONS]

Commands:
  status              Show service status and management URL
  logs [--follow] [--lines N]
                      Show service logs
  restart             Restart the service
  show-info           Show install information
  backup [--protect]  Create a timestamped backup
  restore ARCHIVE [--yes]
                      Restore from a backup archive
  update [VERSION] [--yes] [--prerelease] [--stable-only] [--download-base URL]
                      Guarded update: backup, signature + checksum +
                      state-fingerprint verification, automatic rollback on
                      failure. Downloads follow the install record's
                      DOWNLOAD_BASE; --download-base overrides it. Without
                      VERSION the latest stable release is resolved (GitHub,
                      with a jsDelivr fallback - ADR 0037)
  rotate-path [PATH] [--yes]
                      Rotate to a new Site Path (high-risk, requires --yes)
  reset-mfa --username NAME [--yes]
                      Clear an account's MFA enrollment (lost TOTP device)
  enable-auto-update  Enable weekly auto-update timer (stable channel only)
  disable-auto-update Disable auto-update timer
  uninstall [--purge] [--yes]
                      Remove ProxyHub (high-risk, requires --yes)
  help                Show this help message

Options:
  --help              Show help for a command
  --yes               Skip confirmation prompts (required for high-risk ops)
  --prerelease        With update: allow installing a prerelease version
  --stable-only       With update: reject prereleases (used by auto-update)
  --download-base URL With update: mirror download base (overrides the
                      install record's DOWNLOAD_BASE; https:// only)
  --purge             With uninstall: also remove state and backups
  --username NAME     With reset-mfa: the account to reset
EOF
}

# main - entry point.
main() {
    if [[ ${EUID:-$(id -u)} -ne 0 ]] && [[ -z "${PROXYHUB_ALLOW_NON_ROOT:-}" ]]; then
        _die "proxyhubctl must be run as root"
    fi

    if (( $# == 0 )); then
        usage
        exit 2
    fi

    local cmd="$1"
    shift

    # Honor the listen addr chosen at install time (--listen-addr): regenerated
    # Caddy fragments and health probes must target the recorded port, not the
    # lib.sh default. Re-validate before adopting: the record is root-only, but
    # a corrupted value must not flow unquoted into a root-written Caddy config.
    local record_addr
    record_addr=$(_read_install_field LISTEN_ADDR)
    if [[ $record_addr =~ ^127\.0\.0\.1:[0-9]+$ ]]; then
        PROXYHUB_LISTEN_ADDR="$record_addr"
    elif [[ -n $record_addr ]]; then
        _ph_err "ignoring invalid LISTEN_ADDR in install record: $record_addr"
    fi

    # Adopt the recorded Caddy mode (ADR 0035): every Caddy touch point
    # dispatches on it via the lib.sh channel. Records predating the field
    # mean native. Both variables are consumed by lib.sh through the dynamic
    # source above, which shellcheck cannot follow.
    # shellcheck disable=SC2034
    local record_caddy_mode
    record_caddy_mode=$(_read_install_field CADDY_MODE)
    # shellcheck disable=SC2034
    PROXYHUB_CADDY_MODE="${record_caddy_mode:-native}"
    # shellcheck disable=SC2034
    PROXYHUB_CADDY_CONTAINER=$(_read_install_field CADDY_CONTAINER)

    case "$cmd" in
        help|--help|-h)
            usage
            exit 0
            ;;
        status|logs|restart)
            acquire_lock || exit 1
            "cmd_${cmd}" "$@"
            ;;
        show-info)
            acquire_lock || exit 1
            cmd_show_info "$@"
            ;;
        backup|restore)
            acquire_lock || exit 1
            "cmd_${cmd}" "$@"
            ;;
        update)
            acquire_lock || exit 1
            cmd_update "$@"
            ;;
        rotate-path)
            acquire_lock || exit 1
            cmd_rotate_path "$@"
            ;;
        enable-auto-update)
            acquire_lock || exit 1
            cmd_enable_auto_update "$@"
            ;;
        disable-auto-update)
            acquire_lock || exit 1
            cmd_disable_auto_update "$@"
            ;;
        reset-mfa)
            acquire_lock || exit 1
            cmd_reset_mfa "$@"
            ;;
        uninstall)
            acquire_lock || exit 1
            cmd_uninstall "$@"
            ;;
        *)
            _ph_err "unknown command: ${cmd}"
            usage
            exit 2
            ;;
    esac
}

main "$@"








